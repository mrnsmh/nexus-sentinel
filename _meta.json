{
  "name": "nexus-sentinel",
  "description": "Autonomous SRE Agent. Proactive monitoring, log rotation, and smart service recovery with safety hooks.",
  "version": "1.1.0",
  "author": "Jack (via Marouane)",
  "entrypoint": "SKILL.md",
  "requirements": {
    "binaries": ["docker", "pm2", "tar", "curl"],
